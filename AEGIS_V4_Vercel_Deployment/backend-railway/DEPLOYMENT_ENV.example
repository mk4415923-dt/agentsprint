# Set in Railway Variables — do not commit real values.
AEGIS_DATA_DIR=/data
AEGIS_PUBLIC_URL=https://YOUR-VERCEL-PROJECT.vercel.app
AEGIS_ADMIN_PASSWORD=CHOOSE_A_LONG_RANDOM_PASSWORD_AT_LEAST_12_CHARS
AEGIS_ENTERPRISE_MODE=1
AEGIS_ENABLE_LIVE_GMAIL_SEND=0
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
AEGIS_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
AEGIS_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
AEGIS_GOOGLE_REDIRECT_URI=https://YOUR-VERCEL-PROJECT.vercel.app/api/gmail/callback
# For showing competition sample email inbox on first deployment only:
AEGIS_SEED_SAMPLE_DATA=1
